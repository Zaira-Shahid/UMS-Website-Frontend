# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://umss.pk

# --- Forms (Request a Quote, Contact, Careers) ---
# Resend API key (https://resend.com). Server-side only: never prefix with NEXT_PUBLIC_.
# If RESEND_API_KEY, MAIL_FROM or the matching recipient is empty, submissions are NOT emailed:
# they are printed to the server console instead, so forms still work in development.
RESEND_API_KEY=
# Verified sender address in Resend, e.g. "UMS <noreply@your-verified-domain>"
MAIL_FROM=
# Where each form is delivered (client to confirm). Comma-separate to notify several people.
# The first address is also used as the Reply-To of the visitor confirmation email.
RFQ_TO_EMAIL=
CONTACT_TO_EMAIL=
CAREERS_TO_EMAIL=
# Enable BOQ / drawing uploads on the quote form (PDF, DWG, ZIP; 3 files, 10 MB each).
# NEXT_PUBLIC_ values are baked in at build time: rebuild after changing this.
NEXT_PUBLIC_ENABLE_UPLOADS=false

# --- AI assistant (/api/chat) ---
# Set ONE of these keys to have a model write the answers (streamed, and restricted to the site's own content).
# Server-side only: never prefix with NEXT_PUBLIC_. With neither set, a rule-based responder answers from the site
# content, so the assistant works without any key. Anthropic is used if both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: override the model (defaults: claude-haiku-5-5 for Anthropic, gpt-4o-mini for OpenAI).
CHAT_MODEL=
