# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://umss.pk

# --- Used from Phase 6 (forms) ---
# Resend API key. If empty, form submissions are only logged to the server console.
RESEND_API_KEY=
# Where RFQ / contact / careers emails are delivered (client to confirm)
RFQ_TO_EMAIL=
CONTACT_TO_EMAIL=
CAREERS_TO_EMAIL=
# Verified sender address in Resend
MAIL_FROM=
# Enable RFQ file uploads (BOQ / drawings)
NEXT_PUBLIC_ENABLE_UPLOADS=false

# --- Used from Phase 9 (AI assistant) ---
# If empty, the assistant returns scripted mock answers.
AI_API_KEY=
